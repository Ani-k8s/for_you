# =============================================================================
# ForYou Gym SaaS — Docker Environment Configuration
# =============================================================================
# USAGE: This file is used by docker-compose.yml via env_file: ./backend/.env.docker
#
# KEY DIFFERENCE from backend/.env (local dev):
#   - DB_HOST=db           (Docker container name, NOT 127.0.0.1)
#   - EMAIL_BACKEND=console (safe default — no real emails in Docker dev)
#
# FOR PRODUCTION:
#   1. Copy this file: cp backend/.env.docker backend/.env.prod
#   2. Update SECRET_KEY, DB_PASSWORD, EMAIL credentials
#   3. Set DEBUG=False
#   4. Use: docker-compose -f docker-compose.yml -f docker-compose.prod.yml up
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=docker-dev-secret-key-change-in-production-min-50-chars-abc123xyz
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,backend

# ── Application URLs ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080
BACKEND_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=True

# ── PostgreSQL (uses 'db' container name as host) ────────────────────────────
DB_NAME=foryou_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Authentication & JWT ─────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# ── Super Admin (created by seed command) ────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@foryougym.com
SUPER_ADMIN_PASSWORD=Admin@123!

# ── Demo Seeding ─────────────────────────────────────────────────────────────
GYM_NAME=FitZone Gym
GYM_SUBDOMAIN=fitzone
OWNER_NAME=Ravi Kumar
OWNER_EMAIL=owner@fitzone.com
OWNER_PASSWORD=Owner@123!
DEMO_MEMBERSHIP_PLANS_JSON=[{"name":"Basic","price":"999","duration":"monthly"},{"name":"Premium","price":"1999","duration":"monthly"},{"name":"Yearly","price":"9999","duration":"yearly"}]
NUMBER_OF_DEMO_MEMBERS=10
NUMBER_OF_DEMO_TRAINERS=2
ENABLE_DEMO_PAYMENTS=true
DEMO_USER_PASSWORD=Member@123!

# ── Email Configuration ───────────────────────────────────────────────────────
# Use 'console' in development — prints to stdout (no SMTP required)
# Change to 'smtp' and set EMAIL_HOST_USER/PASSWORD for real emails
EMAIL_PROVIDER=smtp
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ForYou Gym <noreply@foryougym.com>

# ── WhatsApp Configuration ───────────────────────────────────────────────────
# 'stub' = log-only (no real WhatsApp messages sent)
# Change to 'twilio' and set credentials for real WhatsApp
WHATSAPP_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_USER=10000/day
THROTTLE_ANON=1000/day
THROTTLE_BROADCAST=100/hour

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:8000

# ── Security ─────────────────────────────────────────────────────────────────
HTTPS_REDIRECT=False
