# ---- CORE SETTINGS ----
DEBUG=False
SECRET_KEY=generate-a-secure-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,your-production-domain.com

# ---- DATABASE (PostgreSQL) ----
DATABASE_URL=postgres://user:password@db_host:5432/db_name
# OR individual variables:
DB_NAME=foryou_saas
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- AUTH / JWT ----
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# ---- FRONTEND / CORS ----
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- EMAIL (SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="ForYou Gym <noreply@foryougym.com>"
# ---- SUPER ADMIN ----
SUPER_ADMIN_EMAIL=admin@gym.com
SUPER_ADMIN_PASSWORD=Admin@123

# ---- DEMO DATA (Optional) ----
# NUMBER_OF_DEMO_MEMBERS=10
# NUMBER_OF_DEMO_TRAINERS=2
# ENABLE_DEMO_PAYMENTS=true
